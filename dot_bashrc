#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# NVM
export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# GVM (Linux/WSL only)
[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

# Vault aliases
alias vsync='rclone sync /home/upe/obsidian-vault/ gdrive:obsidian-vault/ '
alias vbackup='/home/upe/scripts/backup_vault.sh'
alias vpull='vault sync-pull'
alias vlist='vault list -l 15'
alias vsearch='vault search'
alias vtoday="/home/upe/scripts/generate_daily.sh"
